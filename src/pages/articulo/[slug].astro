---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { categoriaLabel, formatFecha, articulosPublicados, tiempoLectura } from '../../lib/utils.js';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulosPublicados(articulos).map(a => ({
    params: { slug: a.slug },
    props: { articulo: a }
  }));
}

const { articulo } = Astro.props;
const { Content } = await articulo.render();
const { data } = articulo;

const minutos = data.tiempo_lectura ?? tiempoLectura(articulo.body);
const homeHref = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const imageFit = data.layout_imagen === 'contain' ? 'contain' : 'cover';
const fuenteNombre = data.fuente?.nombre?.trim().toLowerCase();
const esFuentePropiaGepac = fuenteNombre === 'gepac';
---
<Base
  title={`${data.meta_titulo ?? data.titulo} · GEPAC`}
  description={data.meta_descripcion ?? data.resumen}
  ogImage={data.imagen?.url}
>

  <article class="article">

    <header class="article-header">
      <div class="article-eyebrow">
        <span class="cat">{categoriaLabel(data.categoria)}</span>
        <time datetime={data.fecha.toISOString()}>{formatFecha(data.fecha)}</time>
        <span>{minutos} min de lectura</span>
      </div>
      <h1 class="article-h1">{data.titulo}</h1>
      {data.subtitulo && <p class="article-subtitle">{data.subtitulo}</p>}

      <div class="article-byline">
        <span><strong>Por</strong> {data.autor}</span>
        {data.fecha_actualizacion && (
          <span><strong>Actualizado</strong> {formatFecha(data.fecha_actualizacion)}</span>
        )}
        {data.fuente?.nombre && (
          <span><strong>Fuente</strong> {data.fuente.nombre}</span>
        )}
      </div>
    </header>

    {data.imagen?.url && (
      <div class="article-cover" data-fit={imageFit}>
        <figure>
          <img src={data.imagen.url} alt={data.imagen.alt} />
          {(data.imagen.caption || data.imagen.credito) && (
            <figcaption>
              {data.imagen.caption}
              {data.imagen.caption && data.imagen.credito && ' · '}
              {data.imagen.credito && <span>{data.imagen.credito}</span>}
            </figcaption>
          )}
        </figure>
      </div>
    )}

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      {data.fuente?.nombre && !esFuentePropiaGepac && (
        <div class="source-card">
          <p class="source-label">Fuente original</p>
          <p class="source-name">
            {data.fuente.url ? (
              <a href={data.fuente.url} target="_blank" rel="noopener">{data.fuente.nombre} ↗</a>
            ) : (
              data.fuente.nombre
            )}
          </p>
        </div>
      )}

      {esFuentePropiaGepac && (
        <div class="source-card social-card">
          <p class="source-label">Puedes seguirnos en</p>
          <div class="social-links" aria-label="Redes sociales de GEPAC">
            <a href="https://www.gepac.es/" target="_blank" rel="noopener" aria-label="Web de GEPAC" class="social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a15 15 0 0 1 0 18"></path><path d="M12 3a15 15 0 0 0 0 18"></path></svg>
            </a>
            <a href="https://x.com/GEPAC_" target="_blank" rel="noopener" aria-label="X de GEPAC" class="social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21l-6.56 7.498L22.16 22h-6.05l-4.74-6.2L5.95 22H3.19l7.02-8.02L2 2h6.2l4.286 5.625L18.244 2Zm-1.06 18h1.527L7.37 3.894H5.73L17.184 20Z"></path></svg>
            </a>
            <a href="https://www.facebook.com/Tengocancer" target="_blank" rel="noopener" aria-label="Facebook de GEPAC" class="social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.36-2.8H13.5V9.4c0-.81.22-1.36 1.38-1.36H16.4V5.54c-.26-.03-1.13-.1-2.15-.1-2.13 0-3.59 1.3-3.59 3.7v2.06H8.25V14h2.41v7h2.84Z"></path></svg>
            </a>
            <a href="https://www.instagram.com/gepac_cancer/?hl=es" target="_blank" rel="noopener" aria-label="Instagram de GEPAC" class="social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
            </a>
          </div>
        </div>
      )}

      <p style="margin-top: var(--s-7); font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-mute);">
        <a href={homeHref} style="color: var(--accent);">← Volver a la portada</a>
      </p>
    </footer>

  </article>

</Base>
